@startuml
title ReMember - Use Case Diagram
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecaseBackgroundColor White
skinparam usecaseBorderColor #344352
actor "Member" as Member
actor "Admin" as Admin
rectangle "ReMember Membership Management System" {
  package "Shared account and organisation functions" {
    usecase "Register an account\n(email or Google)" as S1
    usecase "Sign in / sign out\n(email or Google sign-in)" as S2
    usecase "Verify email / resend code" as S3
    usecase "Reset forgotten password" as S4
    usecase "Edit personal profile\nand notification preferences" as S5
    usecase "Discover organisations\nand view membership tiers" as S6
    usecase "Create an organisation" as S7
    usecase "Select / switch\norganisation portal" as S8
    usecase "Define initial\nmembership tier(s)" as S9
  }
  package "Member functions" {
    usecase "View membership dashboard\nand membership card" as M1
    usecase "Join an organisation" as M2
    usecase "Renew paid membership\nor upgrade tier" as M3
    usecase "Schedule / cancel downgrade;\ncancel / resume subscription" as M4
    usecase "Browse events\nand reservations" as M5
    usecase "RSVP to an event" as M6
    usecase "Cancel an event RSVP" as M7
    usecase "View invoices\nand receipt details" as M8
    usecase "Read organisation posts\nand view notifications" as M9
    usecase "Receive confirmation emails\nand renewal reminders" as M10
    usecase "Select membership tier" as M11
    usecase "Complete demo checkout" as M12
    usecase "Check membership / tier,\nregistration time and capacity" as M13
    usecase "Download invoice" as M14
    usecase "Print receipt" as M15
  }
  package "Admin functions" {
    usecase "View organisation dashboard\nand member analytics" as A1
    usecase "Edit / delete organisation;\nmanage visibility and branding" as A2
    usecase "Search and filter\nmember directory" as A3
    usecase "Activate, suspend or\nrevoke memberships" as A4
    usecase "Assign / change\nmember tiers" as A5
    usecase "Manage tiers, prices,\nbenefits and capacity" as A6
    usecase "Create / edit / delete events\nand inspect attendees" as A7
    usecase "View financial metrics\nand payment transactions" as A8
    usecase "Export filtered\nmember data as CSV" as A9
    usecase "Customise welcome emails\nand renewal reminder settings" as A10
    usecase "View and filter\naudit activity logs" as A11
    usecase "Create / edit / delete\norganisation posts" as A12
    usecase "View demo payment methods\nand gateway information" as A13
  }
}
Member -- S1
Admin -- S1
Member -- S2
Admin -- S2
Member -- S3
Admin -- S3
Member -- S4
Admin -- S4
Member -- S5
Admin -- S5
Member -- S6
Admin -- S6
Member -- S7
Admin -- S7
Member -- S8
Admin -- S8
Member -- M1
Member -- M2
Member -- M3
Member -- M4
Member -- M5
Member -- M6
Member -- M7
Member -- M8
Member -- M9
Member -- M10
Admin -- A1
Admin -- A2
Admin -- A3
Admin -- A4
Admin -- A5
Admin -- A6
Admin -- A7
Admin -- A8
Admin -- A9
Admin -- A10
Admin -- A11
Admin -- A12
Admin -- A13
S7 ..> S9 : <<include>>
M2 ..> M11 : <<include>>
M3 ..> M12 : <<include>>
M6 ..> M13 : <<include>>
M12 ..> M2 : <<extend>>\n[paid tier selected]
M14 ..> M8 : <<extend>>\n[download requested]
M15 ..> M8 : <<extend>>\n[print requested]
note bottom of Admin
  Admin means owner of the selected organisation.
  The same account can be a Member in another organisation.
end note
note bottom of M12
  Checkout simulates payment; no money is charged.
  Free-tier joining does not require checkout.
end note
note bottom of M4
  Scheduling a downgrade does not require checkout.
  Paid cancellations retain access until expiry.
end note
note bottom of M10
  Emails depend on applicable preferences and organisation settings.
  Renewal reminders run X days before membership expiry.
end note
@enduml
