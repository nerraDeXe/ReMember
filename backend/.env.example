# ========================================================
# ReMember - Environment Configuration Template
# ========================================================

PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>

JWT_SECRET=your_secure_jwt_secret_here
# Session duration is fixed: 24 hours, or 30 days with Remember Me.

# Frontend URL used in password reset emails.
APP_WEB_URL=http://localhost:5173

# Google OAuth client ID for a Web application (not a Google Wallet issuer ID).
GOOGLE_CLIENT_ID=

GOOGLE_WALLET_ISSUER_ID=3388000000022341234
GOOGLE_WALLET_CLASS_ID=ReMemberClub_GeneralPass
APP_ORIGIN=https://remember-club.io

EMAIL_SENDER_NAME="ReMember Membership Concierge"
EMAIL_SENDER_ADDRESS="notifications@remember-club.io"

# SMTP delivery for account verification (required for new users to proceed)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="ReMember <notifications@your-domain.com>"
